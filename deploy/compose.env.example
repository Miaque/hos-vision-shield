# 复制为仓库根目录 .env.compose，不覆盖本机 .env。
MODEL_DIR=/srv/vision-shield/models
MEDIA_DIR=/srv/vision-shield/data
BIND_ADDRESS=127.0.0.1
API_PORT=8000
RTSP_PORT=8554
# 外部调用时改为客户端可达的服务器地址，并修改 BIND_ADDRESS。
RTSP_PUBLIC_BASE_URL=rtsp://127.0.0.1:8554
# 授权远程媒体主机及其实际 IP/CIDR；默认仅支持本地上传。
SOURCE_ALLOWLIST=[]
# GPU 模式必填一张卡的编号或完整 GPU UUID；推荐 UUID。
# GPU_DEVICE_ID=GPU-替换为实际UUID
