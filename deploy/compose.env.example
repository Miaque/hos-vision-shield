# 复制为仓库根目录 .env.compose，不覆盖本机 .env。
# 生产默认 false；性能优化或诊断时改为 true 并重新创建应用容器。
DEBUG=false
STREAM_OUTPUT_PACING=true
MODEL_DIR=/data/hos-vision-shield/models
MEDIA_DIR=/data/hos-vision-shield/data
# 独立回放容器的只读视频目录，须包含 rfm-01.mp4 和 rfm-02.mp4。
REPLAY_MEDIA_DIR=/data/hos-vision-shield/data/replay
BIND_ADDRESS=192.168.1.104
API_PORT=8000
RTSP_PORT=8554
# 客户端通过宿主机局域网 IP 访问 API 和 RTSP。
RTSP_PUBLIC_BASE_URL=rtsp://192.168.1.104:8554
# 授权远程媒体主机及其实际 IP/CIDR；默认仅支持本地上传。
SOURCE_ALLOWLIST=[]
# 通知只走 RabbitMQ；默认 vhost /，每个环境/服务使用独立目标。
# 例：NOTIFICATION_TARGETS='["dev.platform","dev.event-hub"]'
VISION_SHIELD_NOTIFICATION_AMQP_URL=
NOTIFICATION_TARGETS=[]
HLS_CDN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
HLS_PORT=8888
NOTIFICATION_LIMIT=1000
MEDIA_DISK_HIGH_WATERMARK=0.95
# 复用宿主机已发布的 Redis；填写 URL 编码后的密码，使用 6 号数据库。
REDIS_URL='redis://:URL_ENCODED_PASSWORD@192.168.1.104:6378/6'
# GPU 模式必填一张卡的编号或完整 GPU UUID；推荐 UUID。
GPU_DEVICE_ID=GPU-1ed1e2c7-b5a4-36be-4c3e-3e2ff4a1d760
