FROM golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
ADD --checksum=sha256:476d8b8ebbbf78924fff22aca7f87561f2dd8696ecf0a05eaa5140aed2fcff54 https://codeload.github.com/bluenviron/mediamtx/tar.gz/914e39535ece709919ac325aaeed98d394ed9093 /tmp/mediamtx.tar.gz
ADD --checksum=sha256:82f97f877d6e58000ab0e16557c2b6921be20aeeeac1985239dd7e34c39ca547 https://codeload.github.com/bluenviron/gortsplib/tar.gz/09cc2060a7188c1f5f58498a8ede1e56338cd804 /tmp/gortsplib.tar.gz
WORKDIR /build
RUN mkdir mediamtx gortsplib \
    && tar -xzf /tmp/mediamtx.tar.gz -C mediamtx --strip-components=1 \
    && tar -xzf /tmp/gortsplib.tar.gz -C gortsplib --strip-components=1
COPY deploy/mediamtx-test/rtp-info.patch deploy/mediamtx-test/delayed_test.go ./
RUN cd gortsplib \
    && echo 'd8e5db9ef0d397d21d9fa1be77dec9160e3e01190b133e067e80e04210ac1f95  server_stream_format.go' | sha256sum -c - \
    && awk '/\/\/ sequence number of the first packet of the stream/ { print "\t// Delayed live media cannot use wall-clock extrapolation as its join timestamp.\n\tif age := now.Sub(ssf.lastNTP); age > time.Second || age < -time.Second {\n\t\treturn nil\n\t}\n" } { print }' server_stream_format.go > /tmp/server_stream_format.go \
    && mv /tmp/server_stream_format.go server_stream_format.go \
    && echo '1b665a16e0d2bd608b937e7250c7902e6456e435e8f15df4f852e80d2c152e93  server_stream_format.go' | sha256sum -c - \
    && cp /build/delayed_test.go server_stream_delayed_test.go
ENV CGO_ENABLED=0 GOMAXPROCS=4
RUN cd gortsplib && go test -p 4 -run TestDelayedMediaRTPInfo -count 1 .
RUN cd mediamtx \
    && go mod edit -replace github.com/bluenviron/gortsplib/v5=../gortsplib \
    && printf 'v1.21.2-hos-rtp-info-01' > internal/core/VERSION \
    && go generate ./internal/servers/hls \
    && go build -p 4 -o /build/mediamtx-patched .

FROM bluenviron/mediamtx:1.21.2@sha256:c7540465f868a02652118bea5a0daab12a29ac0f6cb8485abd535939ecddf886
COPY --from=build /build/mediamtx-patched /mediamtx
