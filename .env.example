# Native Windows processes share these local endpoints.
REDIS_URL=redis://127.0.0.1:16379/0
MEDIA_ROOT=data
DETECTION_BACKEND=quality
# 本机 GTX 1080 使用 cuda；无显卡环境设置 cpu。
INFERENCE_DEVICE=cuda
FACE_MODEL_PATH=models/yunet_face.onnx
PLATE_MODEL_PATH=models/hyperlpr_plate.onnx
EGOBLUR_FACE_MODEL_PATH=models/face.jit
EGOBLUR_PLATE_MODEL_PATH=models/license_plate.jit
# Robot footage: 15% margins; the HyperLPR plate mask doubles horizontal padding.
DETECTION_MAX_SIDE=1280
DETECTION_BOX_PADDING=0.15
MEDIAMTX_CONTROL_URL=http://127.0.0.1:9997
RTSP_PUBLIC_BASE_URL=rtsp://127.0.0.1:8554
# 仅容器设置 RTSP_PUBLISH_BASE_URL；本机不设置，沿用公开地址。
# RTSP_PUBLISH_BASE_URL=rtsp://mediamtx:8554
# Deny remote media by default. Set exact hosts/IPs or approved CIDRs as JSON.
SOURCE_ALLOWLIST=[]
FILE_TASK_LIMIT=100
STREAM_TASK_LIMIT=100
MESSAGE_LIMIT=100
FRAME_BUFFER_SIZE=2
# CPU inference at 1280 is slower; the independent 4 MiB limit still applies.
AUDIO_BUFFER_SECONDS=16
AUDIO_BUFFER_BYTES=4194304
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_BYTES=2147483648
MAX_VIDEO_SECONDS=3600
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
DOWNLOAD_TIMEOUT=1800
UPLOAD_TIMEOUT=1800
RTSP_CONNECT_TIMEOUT=10
RTSP_READ_TIMEOUT=10
HEARTBEAT_SECONDS=5
LEASE_SECONDS=20
RECONCILE_SECONDS=5
PROCESS_STOP_TIMEOUT=10
